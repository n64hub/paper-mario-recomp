# The Paper Mario decomp's build (lib/papermario's SETUP.md and install_deps.sh): Ubuntu 24.04, its packages, its
# Python requirements and its two Rust tools. Its compilers (install_compilers.sh) are downloaded into the checkout by
# tools/build_decomp.sh, inside this image.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        binutils-mips-linux-gnu \
        build-essential \
        ca-certificates \
        cargo \
        cpp-mips-linux-gnu \
        curl \
        gcc-mips-linux-gnu \
        git \
        libyaml-dev \
        make \
        ninja-build \
        python3 \
        python3-pip \
        python3-setuptools \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /tmp/requirements.txt
# Rust from rustup: the tools need a newer one than Ubuntu's.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal &&     /root/.cargo/bin/cargo install --root /usr/local pigment64 crunch64-cli &&     rm -rf /root/.cargo /root/.rustup
